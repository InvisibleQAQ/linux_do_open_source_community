# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# pywrangler generated artifacts.
# `pylock.toml` is deliberately NOT ignored: it is the resolved lock and the only
# thing that pins the wasm wheel set (including pydantic-core) reproducibly across
# machines. Commit it.
python_modules/
.venv-workers/

# Cloudflare — secrets and local state. NEVER commit these.
# `.env` is canonical. Legacy `.dev.vars` stays ignored so old secrets cannot
# accidentally enter Git during migration.
.wrangler/
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

# Trellis — TRACKED on purpose. `.trellis/spec/` governs the code in this repo
# and belongs in the same history as the code it governs; `.trellis/tasks/`
# carries the PRDs and decision trail.
#
# The negation below exists because a machine-level global gitignore may carry
# a blanket `.trellis/` (this repo's author's does). A repo-local `.gitignore`
# outranks `core.excludesFile`, so this line restores tracking without anyone
# having to fix their global config — and a fresh clone behaves the same
# whatever the cloner's global config says.
#
# What must NOT be tracked inside `.trellis/` is defined by `.trellis/.gitignore`
# (local developer identity, the per-dev current-task pointer, agent runtime
# state, backups, caches). That file is authoritative — do not duplicate its
# rules here, and never `git add -f .trellis/`: `-f` bypasses it and drags in
# `.developer`, `.runtime/` and every backup directory.
!.trellis/
.trellis/.runtime/
.trellis/scripts/**/__pycache__/

# Editors / OS
.DS_Store
Thumbs.db
*.local
.idea/
.vscode/
