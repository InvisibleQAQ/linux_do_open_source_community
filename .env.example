# Local configuration for `uv run pywrangler dev`.
#
# Copy this file to `.env` and replace every placeholder. Do not keep a
# `.dev.vars` file alongside it: Wrangler ignores `.env` whenever `.dev.vars`
# exists. Values here override the same-named `vars` in `wrangler.jsonc`.
#
# Production uses different configuration paths:
#   * LLM_API_KEY:     `uv run pywrangler secret put LLM_API_KEY`
#   * everything else: `wrangler.jsonc` under `vars`
#
# ---------------------------------------------------------------------------
# LLM_PROTOCOL — which wire protocol the endpoint speaks. Never probed at
# runtime; if it is wrong you get HTTP 404, reported as `endpoint_config`.
#
#   responses          OpenAI Responses API     -> {LLM_BASE_URL}/responses
#   chat_completions   OpenAI Chat Completions  -> {LLM_BASE_URL}/chat/completions
#   anthropic          Anthropic Messages       -> {LLM_BASE_URL}/v1/messages
#
# Pick `chat_completions` for vLLM, Ollama, LM Studio, most relay gateways, and
# Gemini through its OpenAI compatibility layer (`/v1beta/openai`).
#
# LLM_BASE_URL is the API *root*. It must be https:// and must not contain `?` or
# `#` — the protocol's suffix is appended to it as a PATH, so a query string
# cannot survive. The `/v1` convention differs per protocol:
#
#   responses / chat_completions   https://host/v1             (keep /v1)
#   anthropic                      https://api.anthropic.com   (NO /v1)
#
# Pasting the provider's full endpoint URL is tolerated when the trailing path is
# the one the SELECTED protocol appends: it is stripped back to the root, and one
# WARNING per run says so. A path belonging to a DIFFERENT protocol is refused at
# startup instead — there the wrong value is LLM_PROTOCOL rather than the URL, and
# stripping it would only move the failure into a cron run five minutes later.
# See docs/adr/0006-llm-base-url-normalization.md.
#
# LLM_SCHEMA_MODE — how much of the JSON Schema reaches the model.
#
#   strict        the canonical_url enum is enforced by the endpoint. Default.
#                 Equally strong under all three protocols: `anthropic` sends the
#                 same `strict` flag on its forced tool definition. An endpoint
#                 that rejects the flag answers 4xx — pick a mode below instead.
#   json_object   only "must be JSON"; the schema moves into the prompt.
#                 Needed by DeepSeek and ZhiPu, which reject json_schema.
#   none          no output-format field at all, for endpoints that reject one.
#
# Anything but `strict` logs a WARNING on every run and gives up the structural
# guard — a fabricated repository is still rejected by the allowlist re-check, so
# the cost is more rejected decisions, not bad data. There is no automatic
# fallback: a failed request is never retried under a weaker mode.
# See docs/adr/0005-llm-multi-protocol.md.
# ---------------------------------------------------------------------------

LLM_PROTOCOL="responses"
LLM_SCHEMA_MODE="strict"
LLM_API_KEY="replace-with-api-key"
# API root only. responses / chat_completions keep /v1; anthropic takes none.
# A trailing endpoint path of the selected protocol is stripped with a WARNING;
# one belonging to another protocol aborts startup.
LLM_BASE_URL="https://replace-with-provider-host/v1"
LLM_MODEL="replace-with-model-id"
