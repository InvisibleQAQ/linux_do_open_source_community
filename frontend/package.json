{
  "name": "linuxdo-oss-frontend",
  "version": "0.1.0",
  "description": "Linux.do GitHub 开源项目聚合器 — 前端",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "tsc:check": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run tsc:check && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@fontsource/barlow": "^5.2.8",
    "@iconify/react": "^6.0.2",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.102.8",
    "dayjs": "^1.11.20",
    "es-toolkit": "^1.46.1",
    "framer-motion": "^12.38.0",
    "minimal-shared": "^1.1.6",
    "nprogress": "^0.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.0",
    "simplebar-react": "^3.3.2",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@mui/x-date-pickers": "^9.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.6.2",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "comment": "See docs/DEPENDENCY-PINS.md for why typescript is held at 5.9 and eslint at 9."
  }
}
